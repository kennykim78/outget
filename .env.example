# Outget — 환경 변수 예시. 실제 값은 .env 에만 두고 절대 커밋하지 말 것.
# (.gitignore 가 .env / .env.* 를 제외하고 .env.example 만 허용)

# --- client (Vite — VITE_ 접두사만 브라우저로 노출됨) ---
# 네이버 지도 JS v3 (Web Dynamic Map) Client ID. 콘솔에서 도메인 제한 설정할 것.
VITE_NAVER_MAP_CLIENT_ID=

# --- server ---
# JWT 서명 시크릿 (Epic 1.3 auth에서 사용). 충분히 긴 랜덤 문자열로 교체.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# CORS 허용 오리진 (쉼표 구분 가능). 예: http://localhost:5173
CORS_ORIGIN=

# Prisma 데이터소스 (SQLite). 로컬 개발 기본값. 운영은 외부 DB URL 로 교체.
DATABASE_URL="file:./prisma/dev.db"
