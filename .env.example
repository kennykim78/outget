# WithSmall — 환경 변수 예시. 실제 값은 .env 에만 두고 절대 커밋하지 말 것.
# (.gitignore 가 .env / .env.* 를 제외하고 .env.example 만 허용)
#
# ── 운영(NODE_ENV=production, 도커) 변수 표 — R6 A3 ─────────────────────────────────────────────
# 컨테이너 기동 첫 단계(docker-entrypoint.sh → node dist/config/env.js)가 아래 "필수"를 한 번에 검사해
# 누락·무효 이름을 모두 출력하고 기동을 멈춘다. 시크릿 값은 어떤 로그에도 출력하지 않는다.
#
#   구분      변수                  규칙                                              없을 때
#   ------   --------------------  -----------------------------------------------   -------------------------
#   필수      NODE_ENV              production (development·test 외 값은 전부 운영 취급)  미설정도 운영 취급 + 경고
#   필수      PUBLIC_ORIGIN         https 오리진(경로·끝 슬래시 없이), 메일 링크용          기동 중단
#   필수      JWT_ACCESS_SECRET     32자 이상 무작위(운영자 로그인 access)                 기동 중단
#   필수      JWT_REFRESH_SECRET    32자 이상 무작위(access 와 다른 값)                    기동 중단
#   필수      REACTION_KEY_SECRET   32자 이상 무작위(익명 반응 키 HMAC)                    기동 중단
#   필수      DATABASE_URL          file:/data/prod.db (이미지 기본값 있음)                기동 중단
#   선택      TRUST_PROXY           앞단 프록시 홉 수 정수 0~10(기본 0)                     0 = X-Forwarded-For 무시
#   선택      MAIL_TRANSPORT        resend | console. console 은 운영 금지                  dev: console, 운영: 저장 연결 503(SAVE_UNAVAILABLE)
#   조건부    RESEND_API_KEY        시크릿. MAIL_TRANSPORT=resend 일 때 필수                 resend 면 기동 중단
#   조건부    MAIL_FROM             'WithSmall <noreply@인증 도메인>'. resend 일 때 필수       resend 면 기동 중단
#   선택      PORT                  3001                                              3001
#   선택      WS_BACKUP_KEEP        기동 시 DB 백업 보관 개수(기본 5, 1 이상 정수. 0·음수·비숫자면 기동 중단) 5
#   선택      WS_BACKUP_MAX_AGE_DAYS  DB 백업 보관 일수(기본 7, 1~7 정수 — 처리방침 백업 보관 7일, 8 이상이면 기동 거부). 개수와 나이 둘 다 적용   7
#   선택      WS_CLIENT_DIST        클라이언트 dist 경로. 개발·테스트 전용, 운영(NODE_ENV production)에서는 무시
#   선택      WS_ERASURE_FILE      삭제 묘비 파일(기본 /data/erasures.jsonl). WS_BACKUP_DIR 밖이어야 함 — 겹치면 기동 중단
#   선택      WS_EVENT_DAILY_CAP    익명 이벤트 하루 저장 행 상한(서울 날짜, 기본 10000, 0 이상 정수). 넘치면 저장 없이 204   10000
#   선택      WS_VET_REPORT_DAILY_CAP  병원 제보 하루 저장 상한(기본 100, 0 이상 정수). 넘치면 저장 없이 202               100
#   선택      WS_VET_REPORT_PER_IP_DAILY  병원 제보 IP별 하루 한도(기본 10, 0 이상 정수, 메모리 해시 키만). 넘치면 저장 없이 202   10
#   선택      WS_ALLOW_PRIVACY_PLACEHOLDER  1 이면 /privacy 의 {{KENNY: 자리표시가 남아도 기동(경고). 점검·CI 전용, 공개 운영 금지
#
#   빌드 인자(docker build --build-arg, 값이 이미지에 구워짐 — 시크릿 아님):
#   필수      SITE_ORIGIN           https 공개 오리진(canonical·sitemap·OG). 미설정·localhost·http 면 빌드 실패
#   선택      VITE_NAVER_MAP_CLIENT_ID  네이버 지도 Client ID(콘솔 도메인 제한). 비우면 /vet 목록형
#   선택      WS_INDEXABLE          1 일 때만 robots Allow. 기본 0(비공개) — 공개 결정은 Kenny
#
#   SITE_ORIGIN 은 런타임 ENV 로도 남는다 — PUBLIC_ORIGIN 과 다르면 기동 시 경고(같은 도메인이어야 함).
#   시크릿 생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ───────────────────────────────────────────────────────────────────────────────────────────

# --- client (Vite — VITE_ 접두사만 브라우저로 노출됨) ---
# 네이버 지도 JS v3 (Web Dynamic Map) Client ID. 콘솔에서 도메인 제한 설정할 것.
VITE_NAVER_MAP_CLIENT_ID=

# --- server ---
# 실행 모드. 로컬 개발은 development. development·test 가 아닌 값(비움·오타·staging 포함)은 전부
#   운영 취급(fail-closed, SEC-3 L-6): PUBLIC_ORIGIN·REACTION_KEY_SECRET·JWT 시크릿 32자 이상 필수, console 메일 금지.
# 프로덕션 동일 오리진 배포는 production(서버가 client/dist SPA 를 서빙).
NODE_ENV=development

# 앞단 프록시 홉 수(정수, 기본 0 = X-Forwarded-For 무시). SEC-3 M-2.
#   리미터·반응 익명 키는 이 값으로 정해진 클라이언트 IP(IPv6 는 /56)를 쓴다.
#   예: 로드밸런서 1단 뒤 → 1. true·CIDR·이름은 기동 실패(XFF 위조 방지). 배포 구성 확정 시 설정(R6).
TRUST_PROXY=0

# 서버 포트(기본 3001). client dev 프록시(5173)·도커 EXPOSE 와 일치.
PORT=3001

# JWT 서명 시크릿 (운영자 비밀번호 로그인 전용, HS256 — R5 D3). 충분히 길고 무작위인 값으로 교체할 것.
#   생성 예시(access·refresh 를 각각 따로 생성):
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   dev/prod 시크릿은 분리하고, 운영은 환경변수로 주입(이 파일·코드에 커밋 금지).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# CORS 허용 오리진 (쉼표 구분 가능). 예: http://localhost:5173
# 동일 오리진 단일 컨테이너 배포(운영)에서는 불필요(비워둠).
# 개발: vite dev(5173) → 서버 프록시(changeOrigin) 사용 시 서버 .env 에
#   CORS_ORIGIN=http://localhost:5173 설정 필요.
CORS_ORIGIN=

# Prisma 데이터소스 (SQLite). schema.prisma(server/prisma/) 기준 상대경로 → server/prisma/dev.db.
# 로컬 개발 기본값:
DATABASE_URL="file:./dev.db"
# 프로덕션(도커) 예시 — /data 볼륨의 영속 DB:
#   DATABASE_URL="file:/data/prod.db"

# --- 저장 연결(매직링크, R5 계약 C-R5-2) ---
# 메일 링크의 오리진(예: https://withsmall.kr). 요청 Host 헤더로 링크를 만들지 않는다.
#   비우면 개발 기본값 http://localhost:5173 (Vite dev 서버). production 에서 비우면 서버가 기동하지 않는다.
#   production 은 https 오리진만(경로·끝 슬래시 없이).
PUBLIC_ORIGIN=
# 메일 발송 방식. 비우면: 개발·테스트는 console(서버 콘솔에 링크 출력, 이메일 마스킹),
#   production 은 "저장 불가"(POST /auth/magic/request → 503 SAVE_UNAVAILABLE).
#   값: resend | console. console 은 production 에서 금지(기동 실패). 발신 도메인(SPF/DKIM)·계정은 Kenny 결정(K2).
MAIL_TRANSPORT=
# Resend API 키(시크릿 — 운영 주입, 커밋 금지). MAIL_TRANSPORT=resend 일 때 필수(없으면 기동 실패).
RESEND_API_KEY=
# 발신 주소. MAIL_TRANSPORT=resend 일 때 필수. 형식: 'WithSmall <noreply@인증 도메인>' 또는 'noreply@인증 도메인'.
MAIL_FROM=

# --- 익명 반응 키(R5 계약 C-R5-3) ---
# anonKey = HMAC-SHA256(이 값, 서울 날짜|IP 프리픽스 v4 /24·v6 /56). UA 는 쓰지 않는다. 원문 IP·UA 는 저장하지 않는다.
#   비우면 개발은 기동마다 랜덤(재시작 시 중복 판정 초기화). production 에서는 32자 이상 필수(미달이면 기동 실패, 운영 주입 — K3).
#   생성 예시: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REACTION_KEY_SECRET=

# --- 상품 피드(「많이 찾는 상품」, 기본 꺼짐) — 켜기는 Kenny 승인 뒤 ---
# 빌드(prerender): public 이고 production·허용 오리진(WS_AFFILIATE_ORIGINS)일 때만 켜진다. 비우면 꺼짐.
WS_PRODUCT_FEED=
# 서버 런타임: 피드 썸네일 CSP img-src 허용 호스트(쉼표 구분, 코드 상수 안의 값만). 비우면 추가 0.
WS_FEED_IMG_HOSTS=
# 피드 생성기(scripts/dev/gen-product-feed.mjs, 운영자 로컬 전용) 몰 API 키. 값은 커밋하지 않는다.
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
