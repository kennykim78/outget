// WithSmall (위드스몰) 영속화 스키마 (SQLite).
// 소동물(햄스터, 기니피그 등) 및 앵무새 개인 안심분양·나눔·용품 플랫폼.
//
// 핵심 불변식:
//   1. 자금 미보유(Platform holds no funds): 플랫폼 에스크로/잔액/PG 컬럼 0개.
//      AdoptionPost/SupplyPost 의 price 는 당사자 간 대면 직거래 표시값일 뿐 플랫폼 자금 유입이 아님.
//   2. 위치 비실시간: 사용자 실시간 좌표를 추적/저장하지 않음.
//      게시글(AdoptionPost, SupplyPost) 및 병원(VetClinic)의 핀 좌표(lat/lng)만 옵셔널 저장.
//   3. 동물보호법 & CITES 컴플라이언스 준수 필드 내장.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 사용자 계정 (불변식: 잔액 컬럼 0)
model User {
  id           String   @id
  email        String   @unique
  nickname     String   @default("집사")
  passwordHash String
  role         String   @default("USER") // USER, ADMIN
  createdAt    String   @default("")
}

// Auth — refresh 토큰 회전 추적(jti 단위 단건 활성/폐기).
model RefreshToken {
  jti       String   @id
  sub       String
  expiresAt DateTime
  revoked   Boolean  @default(false)
}

// 분양자/보호자 프로필
model GuardianProfile {
  id           String  @id
  userId       String  @unique
  bio          String?
  activeRegion String  @default("") // 활동 동네 (예: "마포구 연남동")
  experience   String? // 사육 경력
  badgeCount   Int     @default(0)
  lat          Float?  // 대표 활동 지역 앵커 좌표 (옵셔널, 사용자 실시간 위치 아님)
  lng          Float?
}

// 소동물·앵무새 분양/나눔 게시글
model AdoptionPost {
  id                 String  @id
  authorId           String
  category           String  // HAMSTER, PARROT, GUINEA_PIG, RABBIT, OTHER
  speciesDetail      String  // 세부 품종 (예: "골든햄스터", "그린칙 코뉴어")
  petName            String?
  gender             String  // MALE, FEMALE, UNKNOWN
  ageText            String  // 예: "생후 2개월", "1살 추정"
  healthStatus       String  // 접종/건강 상태 설명
  
  // 거래 유형 및 금액 필드 (표시값일 뿐 플랫폼 자금 유입 아님)
  dealType           String  // FREE(무료분양), DEPOSIT(책임비), PAID(개인유료분양)
  price              Int     @default(0) // FREE: 0, DEPOSIT/PAID: 해당 금액
  depositRefundTerms String? // 책임비 반환 조건 (예: "3개월 후 잘 지내는 사진 공유 시 전액 환급")
  
  // 법적 컴플라이언스
  citesSpecies       Boolean @default(false) // CITES 규제 대상 여부 (앵무새)
  citesDocReady      Boolean @default(false) // CITES 양도서류 구비 완료 여부
  
  requiredCageSpec   String? // 분양자가 요구하는 최소 환경 (예: "120L 이상 케이지 필수")
  story              String  // 소개 및 사연
  photos             String  // JSON array of photo URLs
  region             String  // 직거래 가능 동네
  lat                Float?  // 지도 마커 핀 좌표
  lng                Float?
  status             String  // AVAILABLE(분양중), RESERVED(예약중), COMPLETED(분양완료), BLINDED(블라인드)
  createdAt          String
}

// 입양 신청서 (사육환경 인증 필수)
model AdoptionApplication {
  id           String  @id
  postId       String
  applicantId  String
  cagePhotoUrl String  // 사육환경 사진 (필수 증빙)
  experience   String  // 반려동물 양육 경험 서술
  familyAgreed Boolean // 동거인 동의 여부
  commitment   String  // 책임 서약 및 각오
  status       String  // PENDING(검토중), ACCEPTED(승인/채팅열림), REJECTED(거절)
  chatThreadId String? // 승인 시 생성되는 채팅방 ID
  createdAt    String
}

// 용품 나눔 및 중고 직거래 게시글
model SupplyPost {
  id          String  @id
  authorId    String
  title       String
  itemType    String  // CAGE, FEED, TOY, BEDDING, ETC
  dealType    String  // FREE(0원 나눔), USED_DEAL(중고 직거래)
  price       Int     @default(0) // FREE일 경우 0
  description String
  photos      String
  region      String
  lat         Float?
  lng         Float?
  status      String  // AVAILABLE, COMPLETED, BLINDED
  createdAt   String
}

// 특수동물 전문병원 DB (시드 데이터)
model VetClinic {
  id             String  @id
  name           String
  targetPets     String  // "소동물, 조류, 파충류"
  address        String
  phone          String
  lat            Float
  lng            Float
  operatingHours String?
}

// 알림
model Notification {
  id        String  @id
  userId    String
  type      String
  refId     String
  message   String
  createdAt String
  read      Boolean @default(false)
}

// 채팅 메시지(append-only, 삭제 없음 — 증빙 보존)
model Message {
  id        String @id
  threadId  String
  senderId  String
  body      String
  createdAt String
}

// 신고(notice-and-takedown) — 유상판매 업자/학대 의심/CITES 미비 즉시 블라인드
model Report {
  id         String @id
  targetType String // POST, APPLICATION, USER, SUPPLY
  targetId   String
  reason     String // ILLEGAL_COMMERCIAL_SALE, ABUSE_SUSPECTED, CITES_VIOLATION, FRAUD
  status     String // BLINDED, RESOLVED, DISMISSED
  reporterId String
  createdAt  String
}

// 분쟁 감사기록(append-only)
model Dispute {
  id        String @id
  matchId   String
  actorId   String
  action    String
  detail    String
  createdAt String
}

// 무금전 뱃지 (환경 인증, CITES 준수 등)
model Badge {
  userId    String
  type      String
  grantedAt String

  @@id([userId, type])
}
