# WithSmall 앞단 프록시(Caddy 2.8+, 내부 테스트 단계). 배포 위치: /opt/withsmall/Caddyfile(읽기 전용 마운트).
#   비밀번호 없음(Kenny 2026-11-02, ORDERS §40 — 10-27 basic_auth 결정 폐기, 제휴 심사자가 바로 볼 수 있게).
#   검색 노출은 계속 막는다: 이 파일의 X-Robots-Tag "noindex, nofollow"(오류 응답 포함) + 앱 빌드 WS_INDEXABLE=0(robots.txt = Disallow: /).
#   설계: _workspace/119 · docs/ops/deploy.md. 정적 검사: scripts/__tests__/deploy-config.test.mjs.
#
#   접속 기록 0(Kenny 2026-10-27 "접속 기록 남기지 않음"):
#     - 사이트 블록에 log 지시어 없음 → 접속 기록(access log) 자체가 만들어지지 않는다.
#     - 기본 로거에서 http 네임스페이스 전체 제외 → 핸들러 오류 기록(http.log.error — 요청·IP 포함)·
#       프록시 오류(http.handlers.reverse_proxy)·Go 서버 기록(http.stdlib — TLS 핸드셰이크 오류의 원격 IP)도 남기지 않는다.
#     - 남는 것: 인증서 발급(tls.*)·기동 기록. IP·요청 주소 없음.
#   trusted_proxies 없음 → 들어온 X-Forwarded-For 는 무시·덮어쓴다(앱 TRUST_PROXY=1 이 이 한 홉만 믿는다).
#   encode 없음(앱이 .br/.gz 사전 압축본을 직접 서빙). HSTS 는 내부 테스트 동안 끔(공개 전환 때 단계 적용).
#   이 파일은 환경 변수를 읽지 않는다(caddy.env 없음).
{
	log default {
		output stderr
		format console
		exclude http
	}
}

withsmall.kr {
	header {
		-Server
		X-Robots-Tag "noindex, nofollow"
	}
	# Phase 0 운영자 경로 외부 404(Kenny 2026-11-02 ORDERS §41, security 257 4a·4b — 없는 계정도 bcrypt 비교 → 1 OCPU 고갈).
	#   막는 것: 운영자 로그인·토큰 갱신·내 정보·관리 경로. 앱 라우팅(Express)은 끝 슬래시를 같은 경로로 받으므로 슬래시 붙은 형태도 막는다.
	#   Caddy path 매처는 대소문자를 가리지 않는다(Express 도 같음). 열어 두는 것: /auth/magic/*·/auth/session(GET·DELETE)(US-025 저장 흐름) · /auth/logout(운영자 로그아웃
	#   auth.routes.ts:134, 클라 미사용 — 막지 않아도 무해: bcrypt 없음·refresh 쿠키 필요).
	#   respond 는 오류 경로가 아니라 위 header 블록(-Server·noindex)이 그대로 붙고 handle_errors 는 타지 않는다. 본문 0.
	@operator path /auth/login /auth/login/ /auth/refresh /auth/refresh/ /auth/me /auth/me/ /admin /admin/*
	respond @operator 404
	reverse_proxy app:3001
	# 오류 응답(502 등)에도 같은 헤더 — 지연(deferred) 헤더는 오류 경로에 적용되지 않는다(2026-10-27 로컬 재현).
	handle_errors {
		header -Server
		header X-Robots-Tag "noindex, nofollow"
	}
}

# www → apex. 내부 테스트 302(공개 전환 때 308).
www.withsmall.kr {
	header -Server
	redir https://withsmall.kr{uri} 302
}
