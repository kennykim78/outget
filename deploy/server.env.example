# WithSmall 앱 런타임 env — 서버 /opt/withsmall/server.env(소유 deploy, 0600). 이 예시엔 이름·자리만 있다(값 0).
#   bootstrap.sh 가 처음 만들 때 __SET_ME__ 시크릿 3개를 서버에서 openssl 로 채운다(값은 화면·로그에 나오지 않음).
#   deploy.sh 는 이 파일에 __SET_ME__ 가 남아 있거나 권한이 600 이 아니면 배포를 거부한다.
#   변수 의미 원본: 저장소 루트 .env.example · docs/ops/deploy.md 2절. 값에 $ 를 쓰지 않는다(compose 보간).
NODE_ENV=production
PUBLIC_ORIGIN=https://withsmall.kr
# 앞단 Caddy 한 홉만 믿는다(Caddy 가 X-Forwarded-For 를 덮어씀).
TRUST_PROXY=1
DATABASE_URL=file:/data/prod.db
JWT_ACCESS_SECRET=__SET_ME__
JWT_REFRESH_SECRET=__SET_ME__
REACTION_KEY_SECRET=__SET_ME__
# 메일: Resend 발신 도메인 인증 전에는 비워 둔다 → 이메일 저장 503(SAVE_UNAVAILABLE, 내부 테스트에서 수용).
#   인증 후: MAIL_TRANSPORT=resend + RESEND_API_KEY + MAIL_FROM(Kenny).
MAIL_TRANSPORT=
RESEND_API_KEY=
MAIL_FROM=
# 내부 테스트 전용: 처리방침 {{KENNY: 자리표시가 남아도 기동(경고). 공개 전환 전에 이 줄을 지운다.
#   공개 빌드(Variables WS_INDEXABLE=1 → client/dist/prerender-manifest.json indexable=true)에서는 이 값이 무시되고
#   자리표시가 남아 있으면 기동을 거부한다(security 139 MED-2). 내부 테스트는 WS_INDEXABLE=0 유지, 공개 전 자리표시부터 채운다.
WS_ALLOW_PRIVACY_PLACEHOLDER=1
# 하루 저장 상한(264, 서울 날짜): 넘친 이벤트·제보는 응답은 그대로 두고 저장만 하지 않는다. 비우면 기본값(10000·100).
WS_EVENT_DAILY_CAP=10000
WS_VET_REPORT_DAILY_CAP=100
# 제보 IP별 하루 한도(메모리 해시 키만, 저장·로그 0). 비우면 기본 10.
WS_VET_REPORT_PER_IP_DAILY=10
WS_BACKUP_KEEP=5
WS_BACKUP_MAX_AGE_DAYS=7
